# DASHSCOPE_API_KEY: Required for Qwen/DashScope API calls.
DASHSCOPE_API_KEY="YOUR_DASHSCOPE_API_KEY"

# Qwen OpenAI-compatible text endpoint.
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# Optional dedicated OpenAI-compatible endpoint for qwen3-livetranslate-flash HTTP audio.
# Use an Alibaba Cloud Model Studio workspace domain when the default DashScope endpoint is unsupported for this model.
QWEN_AUDIO_BASE_URL=""

# Qwen realtime WebSocket endpoint for LiveTranslate.
QWEN_REALTIME_WS_URL="wss://dashscope.aliyuncs.com/api-ws/v1/realtime"

# Default Qwen models.
QWEN_CHAT_MODEL="qwen3.7-plus"
QWEN_REALTIME_MODEL="qwen3.5-livetranslate-flash-realtime"
QWEN_AUDIO_HTTP_MODEL="qwen3-livetranslate-flash"
QWEN_HTTP_TIMEOUT_MS="45000"

# Optional lightweight access gate for self-hosted deployments.
INVITE_CODE="CHANGE_ME"

# Optional server port.
PORT="3000"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"
